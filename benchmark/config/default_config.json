{
  "seed": 12345,
  "num_pairs": 32,
  "operations": ["union", "intersection", "difference"],
  "spheres": {
    "count_min": 3,
    "count_max": 5,
    "radius_min_frac": 0.1,
    "radius_max_frac": 0.15,
    "center_mode": "surface",
    "stacks": 14,
    "slices": 28
  },
  "metrics": {
    "sample_count": 8000,
    "boundary_fscore_tol_frac": 0.001
  },
  "limits": {
    "preparation_timeout_sec": 1200,
    "preparation_memory_limit_mb": 16384,
    "method_timeout_sec": 1200,
    "method_memory_limit_mb": 16384,
    "memory_check_interval_sec": 0.01
  },
  "debug": {
    "save_cut_meshes": false,
    "save_expected_result": false
  },
  "plots": {
    "enabled": true,
    "output_subdir": "plots",
    "dpi": 150,
    "formats": ["pdf", "html"],
    "complexity_bins": 80,
    "export_timeout_sec": 30.0,
    "fallback_html_on_export_failure": true
  }
}
