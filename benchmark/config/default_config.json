{
  "seed": 12345,
  "num_pairs": 32,
  "operations": ["union", "intersection", "difference"],
  "spheres": {
    "count_min": 1,
    "count_max": 10,
    "radius_min_frac": 0.02,
    "radius_max_frac": 0.08,
    "center_mode": "surface",
    "stacks": 14,
    "slices": 28
  },
  "metrics": {
    "sample_count": 8000,
    "boundary_fscore_tol_frac": 0.001
  },
  "debug": {
    "save_cut_meshes": true,
    "save_expected_result": true
  },
  "plots": {
    "enabled": true,
    "output_subdir": "plots",
    "dpi": 150,
    "formats": ["pdf"],
    "complexity_bins": 80,
    "export_timeout_sec": 30.0,
    "fallback_html_on_export_failure": true
  }
}
